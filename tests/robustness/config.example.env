# Harness configuration. This file is safe to version and contains no secrets.
#
# Service variables are named PHOTOEDGE_* and configure the Go process.
# Harness variables are named PHOTOEDGE_ROBUST_* and configure this runner.

PHOTOEDGE_ROBUST_BASE_URL=http://127.0.0.1:8090
PHOTOEDGE_ROBUST_API_TOKEN=replace-with-local-test-token
PHOTOEDGE_ROBUST_EVENT_ID=local-event
PHOTOEDGE_ROBUST_DEVICE_ID=camera_01
PHOTOEDGE_ROBUST_STORAGE_ROOT=C:\path\to\discardable\photoedge-root
PHOTOEDGE_ROBUST_DB_PATH=C:\path\to\discardable\photoedge-root\db\orchestrator.db

# Optional stdout capture produced by the operator, not by the service itself.
PHOTOEDGE_ROBUST_LOG_PATH=

PHOTOEDGE_ROBUST_HTTP_TIMEOUT_SECONDS=30
PHOTOEDGE_ROBUST_PROCESSING_TIMEOUT_SECONDS=30
PHOTOEDGE_ROBUST_POLL_INTERVAL_MS=250
PHOTOEDGE_ROBUST_DEFAULT_PHOTOS=10
PHOTOEDGE_ROBUST_DEFAULT_CONCURRENCY=2
PHOTOEDGE_ROBUST_REPORTS_DIR=tests/robustness/reports
